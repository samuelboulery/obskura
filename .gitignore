# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ovrsee : journal de planification local (plans, tickets, captures). Utile en
# session, hors sujet pour un dépôt public — gardé sur disque, hors de git.
/ovrsee/
/ovrsee.config.json

# Captures d'écran ovrsee : régénérées à chaque commit, purge auto côté
# disque (30j puis 1/semaine) — inutile de les suivre dans git.
ovrsee/pages/shots/

# État de travail des sessions Claude (ovrsee) : local à une machine, jamais
# versionné.
ovrsee/.active/
ovrsee/.active-plan
ovrsee/.active-ticket
